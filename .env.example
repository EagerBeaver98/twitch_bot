# Twitch OAuth Token (get from https://twitchtokengenerator.com/)
TWITCH_TOKEN=your_oauth_token_here

# Your Twitch Client ID (get from https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=your_client_id_here

# The channel name to connect to (your Twitch username, lowercase)
TWITCH_CHANNEL=your_channel_name

# Bot nickname (usually your Twitch bot account username)
TWITCH_NICK=your_bot_username

# Twitch Client Secret (get from https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_SECRET=your_client_secret_here